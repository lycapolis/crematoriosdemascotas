# ═══════════════════════════════════════════════════════════
# .env.example — plantilla de variables de entorno
# ═══════════════════════════════════════════════════════════
# Copiar este archivo como `.env` y rellenar con valores reales.
# El archivo .env NO se sube a git (está en .gitignore).
# Este .env.example SÍ se sube, para documentar qué variables espera la app.

# Anthropic Claude API key (sk-ant-...)
# Obtener en https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# API key del asistente IA (api-ai/asistente/*.php), consumida por N8N.
# Generar una key aleatoria fuerte, ej: openssl rand -base64 32
ASISTENTE_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — proveedor alternativo a Claude,
# configurable por sección en admin/configuracion-ia.php (solo super_admin).
OPENROUTER_API_KEY=

# ─── SMTP / Titan (Hostinger) ────────────────────────────────
# Para envío autenticado de notificaciones (leads, etc).
# Si SMTP_HOST se deja vacío → fallback a mail() nativo (uso local).
# En producción Hostinger configurar DKIM/SPF/DMARC en el panel del dominio.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=notificaciones@crematoriosdemascotas.com
SMTP_FROM_NAME="Crematorios de Mascotas"
SMTP_ENCRYPTION=tls
